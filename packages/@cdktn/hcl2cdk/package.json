{
  "name": "@cdktn/hcl2cdk",
  "version": "0.0.0",
  "description": "Transform HCL into CDK",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "watch-preserve-output": "tsc -w --preserveWatchOutput",
    "test:update": "jest -u",
    "package": "bash package.sh",
    "dist-clean": "rm -rf dist",
    "package:js": "bash package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/open-constructs/cdk-terrain.git",
    "directory": "packages/@cdktn/hcl2cdk"
  },
  "author": {
    "name": "OpenConstructs",
    "url": "https://github.com/open-constructs"
  },
  "keywords": [
    "cdk",
    "cdktf",
    "cdktn",
    "terraform",
    "hcl"
  ],
  "license": "MPL-2.0",
  "dependencies": {
    "@babel/generator": "7.29.7",
    "@babel/template": "7.29.7",
    "@babel/types": "7.29.7",
    "@cdktn/commons": "workspace:*",
    "@cdktn/hcl2json": "workspace:*",
    "@cdktn/provider-generator": "workspace:*",
    "@cdktn/provider-schema": "workspace:*",
    "camelcase": "6.3.0",
    "cdktn": "workspace:*",
    "codemaker": "1.140.0",
    "deep-equal": "2.2.3",
    "glob": "13.0.6",
    "graphology": "0.26.0",
    "graphology-types": "0.24.7",
    "jsii-rosetta": "~6.0.0",
    "prettier": "2.8.8",
    "reserved-words": "0.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/babel__generator": "7.27.0",
    "@types/babel__template": "7.4.4",
    "@types/deep-equal": "1.0.4",
    "@types/fs-extra": "11.0.4",
    "@types/node": "22.20.1",
    "@types/prettier": "2.7.3",
    "@types/reserved-words": "0.1.4",
    "execa": "5.1.1",
    "fs-extra": "11.3.6",
    "tsx": "4.23.1",
    "typescript": "^5.0.4"
  },
  "nx": {
    "tags": ["unit-test"],
    "targets": {
      "test": {
        "dependsOn": ["build", "^build", "cdktn-cli:build"]
      }
    }
  }
}
