{
  "name": "@cdktn/cli-core",
  "version": "0.0.0",
  "description": "CDK Terrain CLI Core, meant for internal use only",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "watch-preserve-output": "tsc -w --preserveWatchOutput",
    "test:update": "jest -u --maxWorkers=50%",
    "package": "bash package.sh",
    "dist-clean": "rm -rf dist",
    "package:js": "bash package.sh"
  },
  "main": "build/lib/index.js",
  "types": "build/lib/index.d.ts",
  "nx": {
    "tags": ["unit-test:terraform"]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/open-constructs/cdk-terrain.git",
    "directory": "packages/@cdktn/cli-core"
  },
  "author": {
    "name": "OpenConstructs",
    "url": "https://github.com/open-constructs"
  },
  "keywords": [
    "cdk",
    "cdktf",
    "cdktn",
    "terraform"
  ],
  "license": "MPL-2.0",
  "dependencies": {
    "@cdktn/commons": "workspace:*",
    "@cdktn/hcl-tools": "workspace:*",
    "@cdktn/hcl2cdk": "workspace:*",
    "@cdktn/provider-schema": "workspace:*",
    "@sentry/node": "7.120.4",
    "cdktn": "workspace:*",
    "chalk": "4.1.2",
    "chokidar": "3.6.0",
    "ci-info": "4.4.0",
    "codemaker": "1.140.0",
    "constructs": "10.8.1",
    "cross-spawn": "7.0.6",
    "fs-extra": "11.3.6",
    "indent-string": "4.0.0",
    "minimatch": "10.2.5",
    "pkg-up": "3.1.0",
    "semver": "7.8.5",
    "sscaff": "2.0.388",
    "strip-ansi": "6.0.1",
    "undici": "8.7.0",
    "xml-js": "1.6.11",
    "xstate": "5.32.4",
    "zod": "4.4.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "tsc-files ambient.d.ts --noEmit"
  },
  "devDependencies": {
    "@cdktn/provider-generator": "workspace:*",
    "@types/cross-spawn": "6.0.6",
    "@types/fs-extra": "11.0.4",
    "@types/node": "22.20.1",
    "@types/semver": "7.7.1",
    "nock": "^14.0.16",
    "prettier": "2.8.8",
    "tsc-files": "1.1.4",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
