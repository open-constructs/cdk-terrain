{
  "name": "@cdktn/provider-generator",
  "version": "0.0.0",
  "description": "Exposes API to generate Terraform CDK provider bindings",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "nx": {
    "tags": ["unit-test:terraform"]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node ./build/__tests__/edge-provider-schema/cli.js ./edge-provider-bindings",
    "watch": "tsc -w",
    "watch-preserve-output": "tsc -w --preserveWatchOutput",
    "test:update": "jest -u",
    "package": "bash package.sh",
    "dist-clean": "rm -rf dist",
    "package:js": "bash package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/open-constructs/cdk-terrain.git",
    "directory": "packages/@cdktn/provider-generator"
  },
  "author": {
    "name": "OpenConstructs",
    "url": "https://github.com/open-constructs"
  },
  "keywords": [
    "cdk",
    "cdktf",
    "cdktn",
    "terraform"
  ],
  "license": "MPL-2.0",
  "dependencies": {
    "@cdktn/commons": "workspace:*",
    "@cdktn/provider-schema": "workspace:*",
    "cdktn": "workspace:*",
    "codemaker": "1.140.0",
    "constructs": "10.8.1",
    "fs-extra": "11.3.6",
    "glob": "13.0.6",
    "jsii": "~6.0.0",
    "jsii-pacmak": "1.140.0"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/node": "22.20.1",
    "typescript": "^5.0.4"
  }
}
