*.ts

!*.d.ts
!*.js
!.jsii

test

# Exclude jsii outdir
dist
coverage

# Staging tree built by scripts/pack.mjs. It holds its own package.json and a
# full nested node_modules; if `npm pack` descends into it, npm aborts with
# "Exit handler never called!" and the build fails.
.pack-staging
# Build state and the jsii-generated compiler config. tsconfig.json is
# regenerated by jsii on every build (and is .gitignore'd for that reason), so
# publishing it asserts compiler settings consumers should not adopt;
# tsconfig.test.json extends it and points at test sources that are not
# shipped; .tsbuildinfo is incremental-build state that embeds absolute paths
# from the build machine. jsii resolves symbol ids from package.json's
# `jsii.tsc` and the assembly metadata, never from a shipped tsconfig.
tsconfig.json
tsconfig.test.json
*.tsbuildinfo
